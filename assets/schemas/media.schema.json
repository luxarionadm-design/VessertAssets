{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Media",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "model3d"
      ]
    },
    "url": {
      "type": "string"
    },
    "aspectRatio": {
      "type": "number"
    },
    "duration": {
      "type": "number"
    }
  },
  "required": [
    "type",
    "url"
  ],
  "additionalProperties": false
}