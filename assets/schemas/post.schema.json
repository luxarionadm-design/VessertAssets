{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Post",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "author": {
      "type": "object"
    },
    "caption": {
      "type": "string"
    },
    "media": {
      "type": "array"
    },
    "likesCount": {
      "type": "integer"
    },
    "commentsCount": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "author",
    "createdAt"
  ],
  "additionalProperties": false
}